    "panelStrong": "rgba(24, 18, 15, 0.96)",
    "neutralTile": "rgba(74, 62, 52, 0.6)",
    "neutralTileBig": "#3A2F28",
    "stone": "#BCAE8C",
    "classColors": {
      "fighter": "#E98C6C",
      "tank": "#A3B3C9",
      "thief": "#B29BE0",
      "archer": "#A3CF83",
      "mage": "#82C3F2",
      "healer": "#F2DE80"
    }
  }
}
