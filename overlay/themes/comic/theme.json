{
  "name": "Dark Fantasy Comic",
  "description": "Bold ink outlines, halftone shading, blackletter lettering and grim inked panels, like a dark fantasy comic book.",
  "script": "theme.js",
  "font": { "family": "Pirata One", "file": "pirata-one.woff2", "weight": "100 900" },
  "fontScale": 1.12,
  "ink": { "color": "#0B0807", "width": 3, "shadow": 6, "shadowAlpha": 0.5 },
